# ==============================================================================
# Git Ignore Configuration
# ==============================================================================

# Environment variables and secrets
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.env
*.env.local
*.env.production

# Python virtual environments & bytecode
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
pytest_cache/
.coverage
htmlcov/

# Node & Frontend build artifacts
node_modules/
frontend/node_modules/
dist/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.local

# Database & Runtime State (SQLite Only)
*.db
*.db-journal
*.db-wal
*.db-shm
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/applications.db*

# Personal uploads & Resumes (Preserve directory structure via .gitkeep)
uploads/
*/uploads/*
data/uploads/*
!data/uploads/.gitkeep

# IDE, OS & Editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
