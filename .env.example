# ==============================================================================
# AI JOB CHAT ASSISTANT - Environment Configuration (.env.example)
# Hidani Tech - SDE Intern Assessment Build
# Copy this file to .env and configure your variables before starting.
# ==============================================================================

# LLM Configuration
# Set OPENAI_API_KEY to your OpenAI API key or leave as 'mock' for local deterministic offline testing
OPENAI_API_KEY=mock
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2

# Application Settings
ENVIRONMENT=development
APP_NAME="Hidani AI Job Assistant"
MAX_HISTORY_TURNS=10

# Server & Network Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration
DATABASE_URL=sqlite:///./data/applications.db

# Storage Paths
JOBS_DATA_PATH=./data/jobs.json
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=10

# Matching Engine Configuration
WEIGHT_SKILLS=0.50
WEIGHT_DESIGNATION=0.25
WEIGHT_EXPERIENCE=0.15
WEIGHT_LOCATION=0.10

